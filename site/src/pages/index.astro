---
import { getCollection } from "astro:content";
import Layout from "../Layout.astro";
import Section from "../Section.astro";
const articles = (await getCollection("articles")).map((a) => a.data);
const sections: Record<(typeof articles)[number]["section"], typeof articles> =
  { environmental: [], community: [], music: [], film: [], womensHealth: [] };
for (const a of articles) {
  sections[a.section].push(a);
}
---

<Layout>
  <div>
    <h1 class="mb-8 text-center text-3xl font-bold">Pamela Rafalow Grossman</h1>
    <p class="mx-auto max-w-prose">
      Pamela Rafalow Grossman is a nationally published journalist (the
      {" "}<em>New York Times</em>, Salon.com, <em>Time</em>, etc.) and has
      edited for many major outlets, including <em>Rolling Stone</em> and
      {" "}<em>Real Simple</em> magazines. Her interests, professionally and personally,
      include environmentalism; women&#39;s health (with a focus on patient advocacy);
      poetry; film (especially documentary); and music of all kinds. Her Substack,
      &quot;Communally,&quot; explores how communities are created, found, threatened,
      or preserved. Pamela is in the process of making her first short documentary,
      on the theme of lifelong friendship. She lives in Brooklyn, NY, and is an active
      member of the North Brooklyn Community Boathouse; the group leads canoe and
      kayak trips that launch onto the Newtown Creek, a Superfund site, and continue
      onto the East River.
    </p>
    <h2 class="my-8 text-center text-xl" id="journalism">
      <a href="#journalism">Journalism</a>
    </h2>
    <div class="mx-auto flex w-max flex-col gap-8">
      <Section name="environmental" />
      <Section name="community" />
      <Section name="music" />
      <Section name="womensHealth" />
      <Section name="film" />
    </div>
  </div>
</Layout>
