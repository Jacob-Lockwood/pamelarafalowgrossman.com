---
import { getCollection } from "astro:content";
import { PortableText } from "astro-portabletext";
import { sections, type SectionValue } from "../../shared";
interface Props {
  name: SectionValue;
}
const { name } = Astro.props;
const articles = (await getCollection("articles"))
  .map((a) => a.data)
  .filter((a) => a.section === name);
const title = sections.find((s) => s.value === name)!.title;
---

<div class="flex flex-col gap-2">
  <h3 class="text-xl">{title}</h3>
  <ul class="flex flex-col gap-2">
    {
      articles.map((a) => (
        <li>
          <a
            href={a.link}
            target="_blank"
            class="flex flex-wrap gap-x-4 text-gray-500"
          >
            <p class="text-gray-800 underline underline-offset-2">{a.title}</p>
            <p>
              <em>{a.publicationName}</em>
            </p>
            <p>{a.publicationDate.toLocaleDateString()}</p>
          </a>
          {a.notes && (
            <div class="mt-1 ml-8 text-gray-600">
              <PortableText value={a.notes} />
            </div>
          )}
        </li>
      ))
    }
  </ul>
</div>
